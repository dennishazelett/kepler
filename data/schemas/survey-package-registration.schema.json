{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kepler.example.org/schemas/survey-package-registration.schema.json",
  "title": "Kepler survey package registration record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_format",
    "record_version",
    "package",
    "sampling_summary",
    "validation_report"
  ],
  "properties": {
    "record_format": {
      "const": "kepler.survey-package-registration"
    },
    "record_version": {
      "const": "1.0.0"
    },
    "package": {
      "$ref": "#/$defs/packageIdentity"
    },
    "sampling_summary": {
      "$ref": "#/$defs/samplingSummary"
    },
    "validation_report": {
      "$ref": "#/$defs/validationReportReference"
    }
  },
  "$defs": {
    "packageIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "survey_id",
        "content_sha256"
      ]
      "properties": {
        "survey_id": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "samplingSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary_derivation",
        "observation_count",
        "target_reference_count",
        "target_count",
        "observation_tables",
        "targets"
      ],
      "properties": {
        "summary_derivation": {
          "$ref": "#/$defs/summaryDerivation"
        },
        "observation_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "target_reference_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "target_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "observation_tables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/observationTableSummary"
          }
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/targetSummary"
          }
        },
        "temporal_extent": {
          "$ref": "#/$defs/temporalExtent"
        }
      }
    },
    "summaryDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "generator",
        "source_manifest",
        "target_identity_normalization"
      ],
      "properties": {
        "profile_id": {
          "const": "kepler-survey-package-registration-v1"
        },
        "profile_version": {
          "const": "1.0.0"
        },
        "generator": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "const": "generate-registry-record.py"
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "source_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relative_path",
            "observation_table_manifest_field"
          ],
          "properties": {
            "relative_path": {
              "const": "survey.json"
            },
            "observation_table_manifest_field": {
              "const": "observation_tables"
            }
          }
        },
        "target_identity_normalization": {
          "const": "trim_only_v1"
        }
      }
    },
    "observationTableSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "observation_specification",
        "instrument_instance_id",
        "observation_count"
      ],
      "properties": {
        "relative_path": {
          "$ref": "#/$defs/posixRelativePath"
        },
        "observation_specification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "instrument_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "observation_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        }
      }
    },
    "targetSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "observation_reference_count"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "observation_reference_count": {
          "$ref": "#/$defs/nonnegativeInteger"
        }
      }
    },
    "temporalExtent": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "provenance",
            "started_at",
            "ended_at"
          ],
          "properties": {
            "status": {
              "const": "available"
            },
            "provenance": {
              "$ref": "#/$defs/temporalExtentProvenance"
            },
            "started_at": {
              "$ref": "#/$defs/dateOrDateTime"
            },
            "ended_at": {
              "$ref": "#/$defs/dateOrDateTime"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "not_available"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "temporalExtentProvenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "source"
          ],
          "properties": {
            "method": {
              "const": "contributor_declared_survey_interval"
            },
            "source": {
              "const": "survey.json"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "included_observation_tables"
          ],
          "properties": {
            "method": {
              "const": "min_max_normalized_utc_observation_timestamp_v1"
            },
            "included_observation_tables": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/posixRelativePath"
              }
            }
          }
        }
      ]
    },
    "validationReportReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "format",
        "schema_version"
      ],
      "properties": {
        "relative_path": {
          "$ref": "#/$defs/validationReportRelativePath"
        },
        "format": {
          "const": "kepler.validation-report+json"
        },
        "schema_version": {
          "const": "1.0.0"
        }
      }
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "posixRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "validationReportRelativePath": {
      "type": "string",
      "const": "validation-report.json"
    },
    "dateOrDateTime": {
      "type": "string",
      "anyOf": [
        {
          "format": "date"
        },
        {
          "format": "date-time"
        }
      ]
    }
  }
}
