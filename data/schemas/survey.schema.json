{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kepler.example/schemas/survey.schema.json",
  "title": "Kepler Survey Metadata",
  "description": "Metadata describing a Kepler survey package.",
  "type": "object",
  "additionalProperties": false,

  "required": [
    "schema_version",
    "survey_id",
    "survey_type",
    "scientific_question",
    "observer_ids",
    "instrument_instance_ids",
    "observation_specification"
  ],

  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Version of this survey metadata schema.",
      "pattern": "^0\\.1$"
    },

    "survey_id": {
      "type": "string",
      "description": "Stable identifier assigned to the survey.",
      "pattern": "^[A-Za-z0-9_-]+$"
    },

    "title": {
      "type": "string",
      "minLength": 1
    },

    "survey_type": {
      "type": "string",
      "description": "Survey classification. Current defined types: instrument_calibration, astronomical_observation. Additional survey types may be introduced in future specification revisions.",
      "minLength": 1
    },

    "scientific_question": {
      "type": "string",
      "minLength": 1
    },

    "observer_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+$"
      }
    },

    "instrument_instance_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^INS-[0-9]{4}$"
      }
    },

    "protocol_id": {
      "type": ["string", "null"]
    },

    "protocol_version": {
      "type": ["string", "null"]
    },

    "observation_specification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },

    "site_id": {
      "type": ["string", "null"]
    },

    "started_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },

    "ended_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },

    "submitted_at": {
      "anyOf": [
        {
         "type": "null"
        },
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },

    "attachments": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attachment_id",
          "path",
          "description"
        ],
        "properties": {
          "attachment_id": {
            "type": "string",
            "pattern": "^ATT-[0-9]{4}$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": ["string", "null"]
          },
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    }
  }
}